# ---------------------------------------------------------------------------
# منصة الدعوات — الأسبوع العلمي السابع
# انسخ هذا الملف إلى .env. لا تضع مفاتيح حقيقية في المستودع.
#
# الواجهة العامة تعمل بلا أي إعداد: التوليد والتنزيل والمشاركة عبر واتساب
# كلّها تجري في المتصفح. ما تحته اختياري ويخصّ السجل والإرسال التلقائي.
# ---------------------------------------------------------------------------

# --- قاعدة البيانات (اختيارية: لتسجيل الدعوات) ------------------------------
# الإنتاج:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mtc_invitations?schema=public"
# التطوير المحلي بلا تثبيت أي شيء:  npm run db:sqlite
# عندها:                            DATABASE_URL="file:./dev.db"

# --- تخزين صور الدعوات ------------------------------------------------------
# خارج public عمدًا: الصور تحمل أسماء المدعوين
INVITATION_STORAGE_DIR=".data/invitations"

# --- المسارات الإدارية ------------------------------------------------------
# رمز يحمي سجل الدعوات وتنزيل الصور والإرسال التلقائي. الواجهة العامة لا
# تستدعي هذه المسارات إطلاقًا. ولّد قيمة عشوائية:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_TOKEN=""

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (اختياري — للإرسال التلقائي من الخادم)
# اتركه فارغًا ولن يتغيّر شيء في الواجهة: الإرسال اليدوي هو الوضع الأساسي.
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_VERSION="v21.0"

# قالب معتمد — مطلوب لبدء محادثة خارج نافذة الـ ٢٤ ساعة
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="ar"

# Webhook: لتأكيد حالتَي «سُلّمت» و«قُرئت»
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
